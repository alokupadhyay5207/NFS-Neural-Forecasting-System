# Copy to .env.local for local development. Only VITE_* values are bundled into the browser build,
# so NEVER put secrets here (no Supabase service-role key, no LLM API key).

# Backend URL. Leave empty in development (Vite proxies /api to http://127.0.0.1:8000).
# In production (Vercel) set it to your Render backend, e.g. https://nfs-api.onrender.com
VITE_API_BASE_URL=

# Supabase (Project Settings -> API). The anon key is designed to be public; Row Level Security protects data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Show "Continue with Google" only after enabling the Google provider in Supabase.
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: where the dev proxy forwards /api (development only).
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
