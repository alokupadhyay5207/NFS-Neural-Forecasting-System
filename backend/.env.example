# NFS backend environment. Copy to .env (never commit it) or set these in the Render dashboard.
# Placeholders only: do not paste real keys into this file.

# --- Supabase (Project Settings -> API) --------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# SERVER-ONLY. Bypasses Row Level Security. Never put it in the frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Only needed if your project still signs tokens with the legacy shared JWT secret (HS256).
# Projects using asymmetric signing keys are verified automatically through the JWKS endpoint.
SUPABASE_JWT_SECRET=

# --- API behaviour -----------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (your Vercel URL in production).
NFS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Require a valid login on the original /api/predict endpoints too. Set to true in production.
NFS_PROTECT_LEGACY_API=false
NFS_MAX_BATCH_ROWS=10000
NFS_MAX_BODY_MB=25
# Per-user request limits (per minute, per server process)
NFS_API_RATE_PER_MIN=120
NFS_BATCH_RATE_PER_MIN=12

# --- AI assistant (optional; the app works without it) ------------------------------------------------
# provider: anthropic | openai   (openai also covers OpenAI-compatible servers via NFS_LLM_BASE_URL)
NFS_LLM_PROVIDER=
NFS_LLM_API_KEY=
NFS_LLM_MODEL=
NFS_LLM_BASE_URL=
NFS_LLM_MAX_TOKENS=900
NFS_CHAT_RATE_PER_MIN=20
